#!/bin/sh
# Hook de pre-commit — Portfolio.
# Source versionnee : ops/hooks/pre-commit. Installation : ops/hooks/install.sh
set -e
cd "$(git rev-parse --show-toplevel)"
# Le dossier git : .git dans le depot, .git/worktrees/<nom> dans un worktree
# (ou .git est un fichier).
GITDIR=$(git rev-parse --absolute-git-dir)
INDEX=$(git diff --cached --name-only --diff-filter=ACM)

echo "-> scan de secrets"
for f in $INDEX; do
  [ -f "$f" ] || continue
  if grep -lIE 'sk-ant-[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' "$f" >/dev/null 2>&1; then
    echo "REFUS : secret detecte dans $f"; exit 1
  fi
done

echo "-> aucun fichier de donnees"
SUSPECTS=$(printf '%s\n' "$INDEX" | grep -iE '\.(csv|xlsx?|jsonl|db|sqlite)$' || true)
if [ -n "$SUSPECTS" ]; then
  echo "REFUS : fichier de donnees indexe :"; printf '        %s\n' $SUSPECTS; exit 1
fi

echo "-> termes interdits (CONTRAT, C1-C4)"
# Listes hors du depot, dans ~/.portfolio. $INDEX non quote : un argument par fichier.
python ops/hooks/verifier_confidentialite.py $INDEX || exit 1

echo "-> identite du commit"
# Le depot est public : l'adresse de l'auteur ne doit pas nommer l'employeur.
git config user.email > "$GITDIR/identite.tmp"
python ops/hooks/verifier_confidentialite.py "$GITDIR/identite.tmp" || { rm -f "$GITDIR/identite.tmp"; echo "        -> git config user.email <adresse perso ou noreply GitHub>"; exit 1; }
rm -f "$GITDIR/identite.tmp"

echo "-> CONTRAT.md sous son plafond"
n=$(wc -l < CONTRAT.md)
if [ "$n" -gt 100 ]; then
  echo "REFUS : CONTRAT.md fait $n lignes, plafond 100."; exit 1
fi

echo "-> build et tests"
# Deux vitesses (modele : UserVoice, registre/0080 ; demande de Jean du
# 2026-11-05). Sur une branche chantier/* : build et tests SANS les passes en
# navigateur, NON bloquants -- un point d'etape rouge passe. Ailleurs, et pour
# toute fusion : build et tous les tests, bloquants, comme avant. Tout ce qui
# precede reste bloquant partout. Une fusion se reconnait a --fusion, que passe
# pre-merge-commit (git n'ecrit MERGE_HEAD qu'apres ce hook, mesure du
# 2026-11-05 sur AuditContenu), ou a MERGE_HEAD pour le commit qui conclut une
# fusion en conflit.
BRANCHE=$(git symbolic-ref --short -q HEAD || true)
RAPIDE=
if [ "${1:-}" != "--fusion" ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  case "$BRANCHE" in chantier/*) RAPIDE=1 ;; esac
fi
# L'execution passe par la commande unique `verifier` (registre/0107) : build
# dans .dist-hook, tests dessus. Le dossier est garde pour les alertes de
# redaction, puis supprime plus bas. Code 1 : rouge (build ou tests). Code 2 :
# verifier refuse son appel, donc le hook lui-meme est faux : bloquant dans les
# deux vitesses.
command -v node >/dev/null 2>&1 || export PATH="$APPDATA/fnm/node-versions/v24.20.0/installation:$PATH"
CODE=0
if [ -n "$RAPIDE" ]; then
  echo "   vitesse rapide ($BRANCHE) : sans tests/*-navigateur.test.mjs"
  npm run verifier -- --rapide --garder .dist-hook || CODE=$?
else
  npm run verifier -- --garder .dist-hook || CODE=$?
fi
if [ "$CODE" -eq 2 ]; then
  rm -rf .dist-hook
  echo "REFUS : verifier refuse son appel (code 2) : le hook est faux, lire le message de verifier ci-dessus."; exit 1
fi
ROUGE=
[ "$CODE" -eq 0 ] || ROUGE="verifier est rouge (sa derniere ligne, ci-dessus, dit si c'est le build ou les tests)"
if [ -n "$ROUGE" ]; then
  if [ -n "$RAPIDE" ]; then
    echo "   ! $ROUGE : NON bloquant sur $BRANCHE ; la fusion jouera build et tests complets"
  else
    rm -rf .dist-hook
    echo "REFUS : $ROUGE."; exit 1
  fi
fi

echo "-> alertes de redaction (non bloquantes)"
# Phrases de plus de 30 mots (registre/0086) : on signale, on ne refuse jamais.
DIST=.dist-hook node ops/alertes/phrases-longues.mjs || true
rm -rf .dist-hook

echo "-> OK"
