#!/bin/sh
# Hook de pre-merge-commit — Portfolio. Une fusion ne passe jamais sans le
# controle complet : le pre-commit entier, en mode --fusion, qui impose build
# et tous les tests, bloquants. --fusion et non MERGE_HEAD : git n'ecrit
# MERGE_HEAD qu'apres ce hook (mesure du 2026-11-05 sur AuditContenu).
# Git ne l'appelle que pour une fusion qui cree un commit sans conflit ; une
# fusion en conflit se conclut par un commit ordinaire, que pre-commit couvre
# par MERGE_HEAD, present a ce moment-la. D'ou `git merge --no-ff` : une avance
# rapide ne cree aucun commit et ne joue aucun hook.
# Source versionnee : ops/hooks/pre-merge-commit. Installation : ops/hooks/install.sh
exec sh "$(git rev-parse --show-toplevel)/ops/hooks/pre-commit" --fusion
