---
// Le gabarit des pages projet (registre/0030), autour de Base :
//  1. la synthèse recruteur : le <h1>, le fait clé en grand, trois phrases ;
//  2. le corps : les H2 libres du Markdown et leurs paragraphes ;
//  3. « Pour aller plus loin », replié dans un <details> : des <h3> et leurs
//     listes, jamais de H2 (le bâtiment compte les H2) ; une section peut
//     porter une image (même balisage que les figures du corps, la
//     visionneuse la prend) et un fichier à télécharger (registre/0061) ;
//  4. la fin : le repère [data-fin] (le toit se pose), puis le lien vers
//     le projet suivant dans l'ordre de l'accueil, en boucle.
// Le contenu vient de src/contenu/projets/ (schéma : src/content.config.ts).
// À partir de 960 px, le bâtiment occupe la colonne de droite (1 : 4) ; en
// dessous, l'indicateur de lecture le remplace, collé sous l'en-tête.
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';
import Batiment from '../components/batiment/Batiment.astro';
import Lecture from '../components/batiment/Lecture.astro';
import Bouton from '../components/Bouton.astro';
import Soleil from '../components/Soleil.astro';
import Visionneuse from '../components/Visionneuse.astro';
import { PROJETS } from '../contenu/projets';
import { moisEnLettres } from '../i18n/date';
import { chemin, type Langue, type Page } from '../i18n/routes';
import { UI } from '../i18n/textes';
// Les schémas insérés dans le corps (src/components/schemas/rehype-schemas.mjs).
import '../components/schemas/chaine-audit.css';
import '../components/schemas/echange-oral.css';

interface Props {
  cle: Page;
  langue: Langue;
  description: string;
}
const { cle, langue, description } = Astro.props;
const t = UI[langue];

const entrees = await getCollection('projets', (e) => e.data.cle === cle && e.data.langue === langue);
if (entrees.length !== 1)
  throw new Error(`Page projet ${cle} (${langue}) : ${entrees.length} fichier(s) dans src/contenu/projets/, attendu un.`);
const { data } = entrees[0];
const { Content, headings } = await render(entrees[0]);
const etages = headings.filter((h) => h.depth === 2);
if (etages.length === 0)
  throw new Error(`Page projet ${cle} (${langue}) : aucun H2, le bâtiment n'aurait pas d'étage.`);

// Le projet suivant : dans l'ordre de l'accueil, en boucle (la fusion, les
// mises en situation, UserVoice, Audit contenu, puis le projet à part, puis
// retour à la fusion) : aucun n'est sauté (src/contenu/projets.ts).
const rang = PROJETS.findIndex((p) => p.page === cle);
const suivant = PROJETS[(rang + 1) % PROJETS.length];

// Le poids affiché d'un fichier à télécharger est celui du fichier servi
// (public/) : arrondi au kilo-octet (1024), « 169 Ko » / « 169 KB ».
const unite = langue === 'fr' ? 'Ko' : 'KB';
for (const { fichier } of data.plusLoin) {
  if (!fichier) continue;
  const octets = statSync(join(process.cwd(), 'public', fichier.href)).size;
  const attendu = `${Math.round(octets / 1024)} ${unite}`;
  if (fichier.poids !== attendu)
    throw new Error(`Page projet ${cle} (${langue}) : ${fichier.href} pèse ${attendu}, l'en-tête affiche « ${fichier.poids} ».`);
}

// La date sous le titre (registre/0045), en toutes lettres (src/i18n/date.ts).
const dateLisible = moisEnLettres(data.date, langue);
---

<Base page={cle} langue={langue} titre={data.titre} description={description}>
  <Lecture etages={etages} />
  <div class="cadre-soleil cadre-soleil--large">
  <Soleil reserve={false} />
  <div class="conteneur projet">
    <article class="projet__article">
      <header class="synthese">
        <h1>{data.titre}</h1>
        <p class="synthese__date"><time datetime={data.date}>{dateLisible}</time></p>
        <p class="synthese__fait">{data.fait}</p>
        <div class="synthese__phrases">
          <p>{data.synthese.probleme}</p>
          <p>{data.synthese.action}</p>
          <p>{data.synthese.resultat}</p>
        </div>
      </header>

      <div class="corps">
        <Content />
      </div>

      <details class="plus-loin">
        <summary>{t.plusLoin}</summary>
        <div class="plus-loin__contenu">
          {
            data.plusLoin.map((section) => (
              <section class="plus-loin__section">
                <h3>{section.titre}</h3>
                {section.points && (
                  <ul>
                    {section.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
                {section.image && (
                  <figure>
                    <a href={section.image.src}>
                      <img
                        src={section.image.src}
                        width={section.image.width}
                        height={section.image.height}
                        loading="lazy"
                        decoding="async"
                        alt={section.image.alt}
                      />
                    </a>
                    <figcaption>{section.image.legende}</figcaption>
                  </figure>
                )}
                {section.fichier && (
                  <p class="plus-loin__fichier">
                    <a href={section.fichier.href} download>
                      {`${section.fichier.libelle} (${section.fichier.format}, ${section.fichier.poids})`}
                    </a>
                  </p>
                )}
              </section>
            ))
          }
        </div>
      </details>
      <span class="projet__fin" data-fin></span>
    </article>

    <div class="projet__chantier" aria-hidden="true">
      <div class="projet__dessin">
        <Batiment etages={etages} />
      </div>
    </div>

    <p class="projet__suivant">
      <Bouton variante="tertiaire" href={chemin(suivant.page, langue)}>
        {`${t.projetSuivant} ${suivant.nom[langue]}`}
      </Bouton>
    </p>
  </div>
  </div>
  <Visionneuse langue={langue} />
</Base>

<style>
  .projet {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  /* 1. La synthèse recruteur. */
  .synthese {
    padding-bottom: clamp(2rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--dalle);
  }

  /* L'ardoise ne passe le contraste qu'en grand texte : 19 px en 700. */
  .synthese__date {
    margin-top: 0.5rem;
    color: var(--ardoise);
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .synthese__fait {
    max-width: 32ch;
    margin-top: 1.25rem;
    font-size: clamp(1.625rem, 1.2rem + 1.9vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    text-wrap: balance;
  }

  .synthese__phrases {
    display: grid;
    gap: 0.5rem;
    max-width: var(--mesure);
    margin-top: 1.5rem;
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  /* 2. Le corps : une ligne de lecture confortable, Atkinson 400. */
  .corps {
    max-width: var(--mesure);
    font-weight: 400;
  }

  .corps :global(h2) {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    scroll-margin-top: 3rem;
  }

  .corps :global(p) {
    margin-top: 1rem;
    line-height: 1.65;
  }

  /* Les captures (registre/0047) : l'image dans un cadre, son fond blanc
     cassé tel quel ; le lien ouvre la visionneuse (Visionneuse.astro, registre/0054),
     le PNG sans JavaScript. La légende en encre :
     l'ardoise ne passe le contraste qu'en grand texte. */
  /* Le navigateur donne 40 px de marge latérale aux <figure> : à zéro.
     Les figures de « Pour aller plus loin » suivent les mêmes règles. */
  .corps :global(figure),
  .plus-loin figure {
    margin: 1.5rem 0 0;
  }

  .corps :global(figure a),
  .plus-loin figure a {
    display: block;
  }

  .corps :global(figure a:focus-visible),
  .plus-loin figure a:focus-visible {
    outline: 3px solid var(--encre);
    outline-offset: 3px;
  }

  .corps :global(figure img),
  .plus-loin figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--dalle);
  }

  /* Les schémas dessinés (registre/0070) : un <picture>, sans lien (la
     visionneuse ne prend que les images dans un lien) ni cadre, le fond
     ivoire du SVG sur l'ivoire de la page. Par défaut, la version étroite,
     dessinée pour 350 px, plafonnée à ~26rem ; à partir de 48,5rem, la
     version grand écran, dessinée pour la colonne (736 px). */
  .corps :global(figure picture) {
    display: block;
  }

  .corps :global(figure picture img) {
    max-width: 26rem;
    border: 0;
  }

  @media (min-width: 48.5rem) {
    .corps :global(figure picture img) {
      max-width: none;
    }
  }

  .corps :global(figcaption),
  .plus-loin figcaption {
    margin-top: 0.5rem;
    color: var(--encre);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* 3. Pour aller plus loin, replié. */
  .plus-loin {
    max-width: var(--mesure);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-block: 1px solid var(--dalle);
  }

  .plus-loin summary {
    padding-block: 1rem;
    font-size: 1.1875rem;
    font-weight: 700;
    cursor: pointer;
  }

  .plus-loin__contenu {
    display: grid;
    gap: 1.75rem;
    padding-bottom: 1.5rem;
    line-height: 1.65;
  }

  .plus-loin__section h3 {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .plus-loin__section ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.625rem 0 0;
    padding-left: 1.25rem;
  }

  .plus-loin__section figure {
    margin-top: 0.75rem;
  }

  .plus-loin__fichier {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  /* Des puces discrètes : l'ardoise, en élément graphique (3 : 1 tenu). */
  .plus-loin__section li::marker {
    color: var(--ardoise);
  }

  /* La colonne pleine (registre/0048) : à partir de 1280 px, le texte prend
     toute la largeur de la colonne, jusqu'au bâtiment ; le corps passe à
     19 px et la synthèse à 20 px, pour rester autour de 80 signes par
     ligne. En dessous, la mesure reste celle des jetons. */
  @media (min-width: 1280px) {
    .synthese__phrases,
    .corps,
    .plus-loin {
      max-width: none;
    }

    .synthese__phrases {
      font-size: 1.25rem;
    }

    .corps,
    .plus-loin__contenu {
      font-size: 1.1875rem;
    }
  }

  /* 4. La fin : le repère du toit, puis le projet suivant. */
  .projet__fin {
    display: block;
    height: 1px;
  }

  .projet__suivant {
    margin-top: 2.5rem;
    font-size: 1.1875rem;
  }

  .projet__chantier {
    display: none;
  }

  /* La colonne du bâtiment, 1 : 4 (registre/0033). La colonne de la grille
     reste vide et garde sa largeur au texte ; le dessin y est fixé à
     l'écran, calé sous l'en-tête (~5rem), du haut au bas de la page. À
     gauche, il garde sa position statique (le bord de la colonne) ; sa
     largeur est celle de la colonne (en fixe, 100 % est la largeur de la
     fenêtre sans la barre de défilement). Sa hauteur laisse en bas la place
     du pied de page (~6rem) ; s'il y entre quand même, le dessin s'efface
     (script de Batiment.astro). */
  @media (min-width: 960px) {
    .projet {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 1fr);
      column-gap: 3rem;
    }

    .projet__article {
      grid-area: 1 / 1;
    }

    .projet__suivant {
      grid-area: 2 / 1;
    }

    .projet__chantier {
      display: block;
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .projet__dessin {
      position: fixed;
      top: 6.5rem;
      width: calc((min(100%, var(--largeur)) - 2 * var(--gouttiere) - 3rem) / 5);
      height: clamp(16rem, calc(100vh - 13rem), 44rem);
      pointer-events: none;
    }
  }
</style>
