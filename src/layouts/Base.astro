---
// Le gabarit commun des huit pages : langue, titre, description, canonique,
// hreflang, favicon, Open Graph, lien d'évitement, en-tête et pied de page.
// Les images (favicon, aperçu) : ops/images/apercu.mjs, registre/0038.
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/atkinson-hyperlegible-next/latin-800.css';
import '../styles/jetons.css';
import '../styles/base.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { LANGUES, LANGUE_PAR_DEFAUT, chemin, type Langue, type Page } from '../i18n/routes';
import { NOM, UI } from '../i18n/textes';
import { INDEXE } from '../i18n/publication';

interface Props {
  page: Page;
  langue: Langue;
  titre: string;
  description: string;
}
const { page, langue, titre, description } = Astro.props;
const absolu = (l: Langue) => new URL(chemin(page, l), Astro.site).href;
const titreComplet = titre === NOM ? titre : `${titre} · ${NOM}`;
// L'aperçu LinkedIn, le même pour toutes les pages.
const apercu = new URL('/og/apercu.png', Astro.site).href;
const APERCU_ALT: Record<Langue, string> = {
  fr: "Jean Perrier, Head of Product · IA appliquée · Data : « Je bâtis sur des hypothèses : j'écoute, je teste, puis j'investis là où ça compte. » Un bâtiment terminé, deux personnages sur le toit, sous un soleil.",
  en: 'Jean Perrier, Head of Product · Applied AI · Data: “I build on hypotheses: I listen, I test, then I invest where it counts.” A finished building, two people on its roof, under a sun.',
};
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!INDEXE && <meta name="robots" content="noindex, nofollow" />}
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolu(langue)} />
    {LANGUES.map((l) => <link rel="alternate" hreflang={l} href={absolu(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolu(LANGUE_PAR_DEFAUT)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOM} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={UI[langue].locale} />
    {LANGUES.filter((l) => l !== langue).map((l) => (
      <meta property="og:locale:alternate" content={UI[l].locale} />
    ))}
    <meta property="og:url" content={absolu(langue)} />
    <meta property="og:image" content={apercu} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={APERCU_ALT[langue]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="evitement" href="#contenu">{UI[langue].evitement}</a>
    <EnTete page={page} langue={langue} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage page={page} langue={langue} />
  </body>
</html>
