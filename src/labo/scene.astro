---
// Page d'essai des animations de l'accueil (registre/0022, 0058, 0062,
// 0069) : les six variantes de Scene. L'en-tête joue au chargement (bouton « Rejouer ») ;
// les cartes au survol et au focus. Hors navigation, hors du site
// construit : le serveur de dev seul la sert, à /labo/scene/
// (astro.config.mjs, registre/0053).
import Scene from '../components/scene/Scene.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Labo · scène de l'accueil</title>
  </head>
  <body>
    <main class="labo">
      <div class="entete">
        <span class="titre">En-tête · l'impatience</span>
        <button type="button" class="rejouer">Rejouer</button>
        <Scene variante="entete" />
      </div>
      <a class="parcelle" href="#">
        <span class="titre">01 · Fusion des plateformes</span>
        <Scene variante="fusion" />
      </a>
      <a class="parcelle" href="#">
        <span class="titre">02 · Mises en situation orales</span>
        <Scene variante="misesEnSituation" />
      </a>
      <a class="parcelle" href="#">
        <span class="titre">03 · UserVoice</span>
        <Scene variante="uservoice" />
      </a>
      <a class="parcelle" href="#">
        <span class="titre">04 · Audit contenu</span>
        <Scene variante="audit" />
      </a>
      <a class="parcelle" href="#">
        <span class="titre">05 · Matrice de compétences</span>
        <Scene variante="matrice" />
      </a>
    </main>
    <script>
      // Rejoue l'impatience de l'en-tête : ses animations repartent de zéro.
      document.querySelector('.rejouer')?.addEventListener('click', () => {
        document.querySelector('.scene--entete')?.getAnimations({ subtree: true }).forEach((a) => {
          a.currentTime = 0;
          a.play();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--ivoire, #FEFAF2);
    color: var(--encre, #2A1F1A);
    font-family: system-ui, sans-serif;
  }
</style>

<style>
  .labo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .entete {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    justify-self: end;
    width: min(100%, 22rem);
  }
  .entete :global(.scene) {
    grid-column: 1 / -1;
  }
  .parcelle {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--encre, #2A1F1A) 15%, transparent);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }
  .parcelle:focus-visible {
    outline: 2px solid var(--orange, #B54E19);
    outline-offset: 3px;
  }
  .titre {
    font-weight: 700;
    font-size: 1.125rem;
  }
</style>
