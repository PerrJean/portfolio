---
// Page d'essai des animations de l'accueil (registre/0022). Hors navigation.
import Scene from '../../components/scene/Scene.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Labo · scène de l'accueil</title>
  </head>
  <body>
    <main class="labo">
      <a class="parcelle" href="#">
        <span class="titre">01 · UserVoice</span>
        <Scene />
      </a>
      <a class="parcelle" href="#">
        <span class="titre">02 · Audit contenu</span>
        <Scene />
      </a>
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--ivoire, #FEFAF2);
    color: var(--encre, #2A1F1A);
    font-family: system-ui, sans-serif;
  }
</style>

<style>
  .labo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .parcelle {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--encre, #2A1F1A) 15%, transparent);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }
  .parcelle:focus-visible {
    outline: 2px solid var(--orange, #B54E19);
    outline-offset: 3px;
  }
  .titre {
    font-weight: 700;
    font-size: 1.125rem;
  }
</style>
