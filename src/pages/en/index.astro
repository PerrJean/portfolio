---
import Base from '../../layouts/Base.astro';
import Parcelles from '../../components/Parcelles.astro';
import Soleil from '../../components/Soleil.astro';
import Scene from '../../components/scene/Scene.astro';
import { UI } from '../../i18n/textes';
---

<Base
  page="accueil"
  langue="en"
  titre="Jean Perrier"
  description="Jean Perrier’s portfolio, in three product projects: listening to user feedback, acting on content quality, and helping the team grow."
>
  <section class="accroche">
    <div class="conteneur accroche__ligne">
      <Soleil />
      <p class="accroche__role">Head of Product · Applied AI · Data</p>
      <h1>I build on hypotheses: I listen, I test, then I invest where it counts.</h1>
      <Scene variante="entete" class="accroche__equipe" />
      <p class="accroche__sous-titre">
        Three projects on an EdTech platform: listening to thousands of learners, fixing what gets in their way, and helping the team that does it grow.
      </p>
    </div>
  </section>

  <section class="conteneur" id="projets" aria-labelledby="titre-projets">
    <h2 id="titre-projets">{UI.en.projets}</h2>
    <Parcelles langue="en" />
  </section>
</Base>
