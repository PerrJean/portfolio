---
import Base from '../../layouts/Base.astro';
import Parcelles from '../../components/Parcelles.astro';
import Soleil from '../../components/Soleil.astro';
import Scene from '../../components/scene/Scene.astro';
import { UI } from '../../i18n/textes';
---

<Base
  page="accueil"
  langue="en"
  titre="Jean Perrier"
  description="Jean Perrier’s portfolio, Head of Product, in five projects: merging two platforms into one, launching AI speaking role-plays, two tools built from scratch with AI, and a PM who grows."
>
  <section class="accroche">
    <div class="conteneur accroche__ligne">
      <Soleil />
      <p class="accroche__role">Head of Product · Applied AI · Data</p>
      <h1>I build on hypotheses: I listen, I test, then I invest where it counts.</h1>
      <Scene variante="entete" class="accroche__equipe" />
      <p class="accroche__sous-titre">
        I merged two platforms into one, launched AI speaking role-plays, built two tools from scratch myself with AI, one that listens to thousands of learners and one that corrects every question, and helped a PM on my team grow.
      </p>
    </div>
  </section>

  <section class="conteneur" id="projets" aria-labelledby="titre-projets">
    <h2 id="titre-projets">{UI.en.projets}</h2>
    <Parcelles langue="en" />
  </section>
</Base>
