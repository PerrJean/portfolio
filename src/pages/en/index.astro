---
import Base from '../../layouts/Base.astro';
import Parcelles from '../../components/Parcelles.astro';
import Soleil from '../../components/Soleil.astro';
import { UI } from '../../i18n/textes';
---

<Base
  page="accueil"
  langue="en"
  titre="Jean Perrier"
  description="Jean Perrier's portfolio, in two product projects: listening to user feedback, then acting on content quality."
>
  <section class="accroche">
    <div class="conteneur accroche__ligne">
      <Soleil />
      <h1>I build on hypotheses: I listen, I test, then I size the effort.</h1>
      <p class="accroche__sous-titre">
        Two projects on an EdTech platform: listening to thousands of learners, then fixing what gets in their way.
      </p>
    </div>
  </section>

  <section class="conteneur" id="projets" aria-labelledby="titre-projets">
    <h2 id="titre-projets">{UI.en.projets}</h2>
    <Parcelles langue="en" />
  </section>
</Base>
