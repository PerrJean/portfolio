---
import Base from '../../layouts/Base.astro';
import Parcelles from '../../components/Parcelles.astro';
import Soleil from '../../components/Soleil.astro';
import Scene from '../../components/scene/Scene.astro';
import { chemin } from '../../i18n/routes';
import { UI } from '../../i18n/textes';
---

<Base
  page="accueil"
  langue="en"
  titre="Jean Perrier"
  description="Portfolio of Jean Perrier, Head of Product, in seven projects: merging two platforms into one, launching AI speaking role-plays, listening to learners and understanding a drop in their score, auditing content with AI, helping a Product Manager grow and listening to five clients before building a dashboard."
>
  <section class="accroche">
    <div class="conteneur accroche__ligne">
      <Soleil />
      <p class="accroche__role">Head of Product · Applied AI · Data</p>
      <h1>I listen, I form hypotheses, I test and I build where it counts.</h1>
      <Scene variante="entete" class="accroche__equipe" />
      <p class="accroche__sous-titre">
        Since 2024, I have led a team of one Product Manager and two Product Designers at an EdTech company of
        around forty people.
      </p>
      <p class="accroche__lien">
        <a href={chemin('monMetier', 'en')}>My job and my strengths, in plain English (2&nbsp;min)</a>
      </p>
    </div>
  </section>

  <section class="conteneur" id="projets" aria-labelledby="titre-projets">
    <h2 id="titre-projets">{UI.en.projets}</h2>
    <Parcelles langue="en" />
  </section>
</Base>
