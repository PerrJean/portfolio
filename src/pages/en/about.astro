---
import Base from '../../layouts/Base.astro';
import Portrait from '../../components/Portrait.astro';
import Soleil from '../../components/Soleil.astro';
import Infobulles from '../../components/infobulles/Infobulles.astro';
import { LINKEDIN } from '../../i18n/textes';
---

<Base
  page="aPropos"
  langue="en"
  titre="About"
  description="Jean Perrier’s background and way of working."
>
  <div class="cadre-soleil">
  <Soleil reserve={false} />
  <article class="conteneur fiche">
    <div class="fiche__portrait"><Portrait /></div>
    <h1>About</h1>
    <Infobulles langue="en">
    <div class="fiche__texte">
      <p>
        Since 2024, I have been Head of Product at GlobalExam, a B2B SaaS scale-up in online language learning. From
        2022 to 2024, I was a Product Manager and Data Product Owner there.
      </p>
      <p>
        I lead a team of one Product Manager and two Product Designers, and support them day to day on their projects,
        from listening to users to going live. I also run some projects myself.
      </p>
      <p>
        Before that, I built digital public services for the French government. At its digital agency (DINUM), I built the Observatoire de la
        qualité des démarches en ligne, which tracks the quality of online public services, and “Je donne mon avis”.
        Then, at the interministerial directorate for public transformation (DITP), I built Services publics +.
      </p>
      <p>
        AI is one of my tools when it brings something
        concrete: sorting feedback, auditing content, prototyping a feature.
      </p>
      <p>Educated at Sciences Po Paris (Master’s in Public Affairs). Fluent in English.</p>
      <p>Get in touch on <a href={LINKEDIN}>LinkedIn</a>.</p>
    </div>
    </Infobulles>
  </article>
  </div>
</Base>
