---
import Base from '../layouts/Base.astro';
import Parcelles from '../components/Parcelles.astro';
import Soleil from '../components/Soleil.astro';
import Scene from '../components/scene/Scene.astro';
import { UI } from '../i18n/textes';
---

<Base
  page="accueil"
  langue="fr"
  titre="Jean Perrier"
  description="Portfolio de Jean Perrier, en deux projets produit : écouter les retours des utilisateurs, puis agir sur la qualité du contenu."
>
  <section class="accroche">
    <div class="conteneur accroche__ligne">
      <Soleil />
      <h1>Je bâtis sur des hypothèses&nbsp;: j’écoute, je teste, puis j’investis là où ça compte.</h1>
      <Scene variante="entete" class="accroche__equipe" />
      <p class="accroche__sous-titre">
        Trois projets sur une plateforme EdTech&nbsp;: écouter des milliers d’apprenants, corriger
        ce qui les gêne, et faire grandir l’équipe qui s’en charge.
      </p>
    </div>
  </section>

  <section class="conteneur" id="projets" aria-labelledby="titre-projets">
    <h2 id="titre-projets">{UI.fr.projets}</h2>
    <Parcelles langue="fr" />
  </section>
</Base>
