---
import Base from '../layouts/Base.astro';
import Parcelles from '../components/Parcelles.astro';
import Soleil from '../components/Soleil.astro';
import Scene from '../components/scene/Scene.astro';
import { UI } from '../i18n/textes';
---

<Base
  page="accueil"
  langue="fr"
  titre="Jean Perrier"
  description="Portfolio de Jean Perrier, Head of Product, en cinq projets : réunir deux plateformes en une, lancer des mises en situation orales avec l’IA, deux outils codés de zéro avec l’IA, et un Product Manager qui grandit."
>
  <section class="accroche">
    <div class="conteneur accroche__ligne">
      <Soleil />
      <p class="accroche__role">Head of Product · IA appliquée · Data</p>
      <h1>J’écoute, je pose des hypothèses, je teste et je construis là où ça compte.</h1>
      <Scene variante="entete" class="accroche__equipe" />
      <p class="accroche__sous-titre">
        Depuis 2024, j’encadre trois Product Managers et Product Designers, dans une entreprise EdTech
        d’une quarantaine de personnes.
      </p>
    </div>
  </section>

  <section class="conteneur" id="projets" aria-labelledby="titre-projets">
    <h2 id="titre-projets">{UI.fr.projets}</h2>
    <Parcelles langue="fr" />
  </section>
</Base>
