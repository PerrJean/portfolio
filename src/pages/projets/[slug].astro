---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chiffres from '../../components/Chiffres.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets', ({ data }) => !data.brouillon);
  return projets.map((p) => ({ params: { slug: p.id }, props: { projet: p } }));
}

const { projet } = Astro.props;
const { Content } = await render(projet);
const d = projet.data;
---
<Base titre={d.titre} description={d.resume}>
  <article>
    <header style="padding-top: 3.5rem;">
      <span class="etiquette">Étude de cas</span>
      <h1 style="margin-top: 1rem; max-width: 22ch;">{d.titre}</h1>
      <p class="mesure" style="font-size: 1.2rem; color: var(--encre-2); margin-top: 1rem;">{d.resume}</p>
      <div class="meta">
        <span data-label="Année">{d.annee}</span>
        <span data-label="Rôle">{d.role}</span>
        <span data-label="Durée">{d.duree}</span>
        <span data-label="Outils">{d.outils.join(', ')}</span>
      </div>
    </header>

    <div class="hero">
      <img src={d.image} alt={d.imageAlt} />
    </div>

    <Chiffres items={d.chiffres} />

    <div class="prose mesure">
      <Content />
    </div>

    <aside class="appris mesure">
      <h2>Ce que j'en retiens</h2>
      <ul>
        {d.appris.map((a) => <li>{a}</li>)}
      </ul>
    </aside>
  </article>
</Base>
