---
// Les parcelles de l'accueil, depuis src/contenu/projets.ts, « la hauteur
// d'abord » (registre/0070) : la première paire, sans flèche (01 et 02) ;
// puis le trio du récit (registre/0084) : 03 UserVoice, 04 l'analyse du
// NPS, 05 l'Audit, reliés par les deux flèches de LIENS_DU_RECIT
// (« Alors j'ai cherché à comprendre. », puis « Alors je me suis attaqué à
// la qualité du contenu. ») ; puis les projets à part, s'il y en a, sans
// flèche. Le trio est posé sur la bande de sable, pleine largeur d'écran ;
// les projets à part viennent dessous, hors de la bande, un par ligne : ils
// n'appartiennent pas au récit (registre/0089, retour sur la remontée de 0084).
// À partir de 960 px, la première paire tient sur une ligne (la colonne du
// milieu reste vide), et le trio « deux puis un » sur la même grille : la
// première flèche horizontale, la seconde en diagonale vers l'Audit. En
// dessous, les parcelles s'empilent et les flèches descendent.
// Dans la première paire, les cartes partagent les lignes de la grille
// (subgrid) : le fait clé part à la même hauteur, même si un nom passe sur
// deux lignes et l'autre non, avec ou sans scène.
import { getCollection } from 'astro:content';
import Parcelle from './Parcelle.astro';
import { LIENS_DU_RECIT, PROJETS, type Projet } from '../contenu/projets';
import { chemin, type Langue } from '../i18n/routes';

interface Props {
  langue: Langue;
}
const { langue } = Astro.props;
// La date de chaque carte, celle de la page projet (registre/0075).
const pages = await getCollection('projets', (e) => e.data.langue === langue);
const dateDe = (p: Projet) => {
  const entree = pages.find((e) => e.data.cle === p.page);
  if (!entree) throw new Error(`Accueil (${langue}) : pas de page projet pour ${p.page}.`);
  return entree.data.date;
};
const hauteur = PROJETS.filter((p) => p.groupe === 'hauteur');
const paire = PROJETS.filter((p) => p.groupe === 'paire');
const aPart = PROJETS.filter((p) => p.groupe === 'a-part');
const proprietes = (p: Projet) => ({
  numero: p.numero,
  nom: p.nom[langue],
  tags: p.tags[langue],
  fait: p.fait[langue],
  date: dateDe(p),
  langue,
  href: chemin(p.page, langue),
  groupe: p.groupe,
  scene: p.scene,
});
---

{
  hauteur.length > 0 && (
    <div class="parcelles parcelles--hauteur">
      {hauteur.map((projet) => (
        <Parcelle {...proprietes(projet)} />
      ))}
    </div>
  )
}

<div class:list={['parcelles', 'parcelles--paire', { 'parcelles--trio': paire.length === 3 }]}>
  {
    paire.map((projet, i) => (
      <>
        {i > 0 && (
          <p class="fleche">
            <span class="fleche__texte">{LIENS_DU_RECIT[i - 1]?.[langue]}</span>
            <svg class="fleche__trait fleche__trait--h" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
              <path d="M8 28 C36 6 78 6 111 25" />
              <path d="M105 14 L111 25 L99 25" />
            </svg>
            <svg class="fleche__trait fleche__trait--v" viewBox="0 0 40 120" aria-hidden="true" focusable="false">
              <path d="M12 8 C34 36 34 78 15 111" />
              <path d="M26 105 L15 111 L15 99" />
            </svg>
            <svg class="fleche__trait fleche__trait--d" viewBox="0 0 160 90" aria-hidden="true" focusable="false">
              <path d="M150 8 C120 60 60 70 14 80" />
              <path d="M26 72 L14 80 L27 86" />
            </svg>
          </p>
        )}
        <Parcelle {...proprietes(projet)} />
      </>
    ))
  }
</div>

{
  aPart.length > 0 && (
    <div class="parcelles parcelles--a-part">
      {aPart.map((projet) => (
        <Parcelle {...proprietes(projet)} />
      ))}
    </div>
  )
}

<style>
  .parcelles {
    /* Le numéro, repère graphique sans écraser le nom (registre/0075). */
    --numero: clamp(3rem, 2rem + 2.5vw, 4rem);
    display: grid;
    margin-top: 2rem;
  }

  .parcelles--paire {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  /* La première paire, sans flèche : empilée, un écart de projet à projet ;
     la paire du récit vient ensuite, à la même distance que le projet à part. */
  .parcelles--hauteur {
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .parcelles--hauteur + .parcelles--paire {
    margin-top: 4rem;
  }

  /* La bande du récit (registre/0089) : le sable sous le trio, de bord à
     bord de l'écran. Une image de bordure, débordant de 100vw de chaque
     côté : un débordement d'encre, qui ne crée pas de barre de défilement
     horizontale (un pseudo-élément de 100vw en créerait une, la largeur de
     la barre verticale comprise). Dans la bande, la carte survolée
     redevient ivoire, et les sols s'inversent (Parcelle.astro). */
  .parcelles--trio {
    padding-block: 3.5rem 4rem;
    border-image: linear-gradient(var(--sable), var(--sable)) fill 0 / 0 / 0 100vw;
  }

  .parcelles--trio > :global(.parcelle) {
    --sol-carte: var(--sol-sur-sable);
  }

  .parcelles--trio > :global(.parcelle:is(:hover, :focus-visible)) {
    --sol-carte: var(--sol);
    background: var(--ivoire);
  }

  /* Les projets à part, un par ligne : chacun reprend seul la grille de la
     paire (Parcelle.astro), le texte à gauche ; côte à côte, ils
     l'écraseraient en trois colonnes étroites. */
  .parcelles--a-part {
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin-top: 4rem;
  }

  /* Après une simple paire (sans bande), le projet à part en est séparé par
     un filet, posé sur le bloc. Sous la bande du récit, la bande suffit
     (registre/0089). */
  .parcelles--paire:not(.parcelles--trio) + .parcelles--a-part {
    padding-top: 1.5rem;
    border-top: 1px solid var(--dalle);
  }

  .fleche {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .fleche__trait {
    display: block;
    flex: none;
    fill: none;
    stroke: var(--encre);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fleche__trait--h {
    display: none;
    width: 7.5rem;
    height: 2.5rem;
  }

  .fleche__trait--d {
    display: none;
  }

  .fleche__trait--v {
    order: -1;
    width: 1.75rem;
    height: 5.25rem;
  }

  @media (min-width: 960px) {
    .parcelles--paire:not(.parcelles--trio) {
      grid-template-columns: minmax(0, 1fr) 7.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    /* La grille de la paire du récit, la colonne du milieu vide : 01 au-dessus
       de 03, 02 au-dessus de 04. Chaque carte prend les trois lignes (titre,
       fait, scène) de la grille commune. */
    .parcelles--hauteur {
      grid-template-columns: minmax(0, 1fr) 7.5rem minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      gap: 0 1rem;
    }

    .parcelles--hauteur > :global(.parcelle) {
      grid-row: 1 / span 3;
      grid-template-rows: subgrid;
    }

    .parcelles--hauteur > :global(.parcelle:nth-child(1)) {
      grid-column: 1;
    }

    .parcelles--hauteur > :global(.parcelle:nth-child(2)) {
      grid-column: 3;
    }

    /* La flèche se place à hauteur du nom, sous le grand numéro. */
    .parcelles--paire:not(.parcelles--trio) .fleche {
      flex-direction: column;
      align-self: start;
      gap: 0.625rem;
      padding-left: 0;
      padding-top: calc(var(--numero) * 0.85 + 0.75rem);
      text-align: center;
    }

    .parcelles--paire:not(.parcelles--trio) .fleche__trait--h {
      display: block;
    }

    .parcelles--paire:not(.parcelles--trio) .fleche__trait--v {
      display: none;
    }
  }

  /* Le trio du récit (registre/0084), « deux puis un » à partir de 960 px :
     UserVoice → l'analyse sur la ligne de la paire, puis la seconde flèche
     descend sous l'analyse vers l'Audit, seul sur sa ligne, à gauche.
     Enfants : 1 UserVoice, 2 flèche, 3 analyse, 4 flèche, 5 Audit. */
  @media (min-width: 960px) {
    .parcelles--trio {
      grid-template-columns: minmax(0, 1fr) 7.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .parcelles--trio > :global(:nth-child(1)) {
      grid-column: 1;
      grid-row: 1;
    }

    .parcelles--trio > :nth-child(2) {
      grid-column: 2;
      grid-row: 1;
      flex-direction: column;
      align-self: start;
      gap: 0.625rem;
      padding-left: 0;
      padding-top: calc(var(--numero) * 0.85 + 0.75rem);
      text-align: center;
    }

    .parcelles--trio > :nth-child(2) .fleche__trait--h {
      display: block;
    }

    .parcelles--trio > :nth-child(2) .fleche__trait--v {
      display: none;
    }

    .parcelles--trio > :global(:nth-child(3)) {
      grid-column: 3;
      grid-row: 1;
    }

    .parcelles--trio > :nth-child(4) {
      grid-column: 1 / span 3;
      grid-row: 2;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      margin: 1rem 0;
      padding-left: 0;
      text-align: center;
    }

    .parcelles--trio > :nth-child(4) .fleche__trait--v {
      display: none;
    }

    .parcelles--trio > :nth-child(4) .fleche__trait--d {
      display: block;
      width: 10rem;
      height: 5.625rem;
    }

    /* La colonne de droite reste vide à côté de l'Audit (registre/0089). */
    .parcelles--trio > :global(:nth-child(5)) {
      grid-column: 1;
      grid-row: 3;
    }
  }
</style>
