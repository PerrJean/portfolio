---
// Le personnage de Jean, debout, lunettes orange : il tient lieu de photo
// sur les pages « À propos » (registre/0037). Décoratif (aria-hidden).
// Les classes de couleur du dessin (fe, se, fi, si, so, voir poses.ts)
// reçoivent ici les jetons, comme dans Scene.astro.
import Personnage from './scene/Personnage.astro';
---

<svg
  class="portrait"
  viewBox="-24 -124 48 128"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <line class="se" x1="-24" y1="0" x2="24" y2="0" stroke-width="1.5" />
  <Personnage pose="debout" jean />
</svg>

<style>
  .portrait {
    display: block;
    width: clamp(3.5rem, 2rem + 6vw, 7rem);
    height: auto;
    overflow: visible;
  }
  .portrait :global(.fe) { fill: var(--encre); }
  .portrait :global(.se) { stroke: var(--encre); }
  .portrait :global(.fi) { fill: var(--ivoire); }
  .portrait :global(.si) { stroke: var(--ivoire); }
  .portrait :global(.so) { stroke: var(--orange); }
</style>
