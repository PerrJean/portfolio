---
// La carte 02 Mises en situation orales (registre/0069) : un board, quatre
// colonnes, et des post-it (le Design Sprint). Au repos, Jean à gauche du
// board, debout, qui le regarde ; la première colonne est pleine ; le PM
// devant le board colle un post-it en bas de la deuxième ; la product
// designer au bord droit (ops/images/mises-en-situation-scene/repos.svg). Au
// survol ou au focus de la carte, en 0,6 s, trois temps de 0,2 s, le board se
// remplit en entonnoir, colonne après colonne : le PM colle le milieu de la
// deuxième, puis fait un pas et colle la troisième ; la designer colle à deux
// mains le seul post-it ambre, à mi-hauteur de la dernière (fin.svg). Jean ne
// bouge pas.
// Jamais un bras au-dessus de l'épaule : les bras du PM restent sous
// l'horizontale, la designer colle à deux mains.
// À rendre dans Scene.astro (variante « misesEnSituation »), qui porte les
// couleurs et le déclenchement sans survol.
// Mesures : ops/images/mises-en-situation-scene/planche.mjs.
import Personnage from './Personnage.astro';
import { OBJETS, montre } from './poses';

const BX = 147, COL = 39, PI = 13;
const RANGS = [-123, -104, -85, -66];
const J_X = 114, PM_1 = BX + COL - 3, PM_2 = BX + 2 * COL - 3, D_X = BX + COL * 3.5 + 30;
const xPostit = (col: number) => BX + COL * (col + 0.5) - PI / 2;
const r1 = (v: number) => Math.round(v * 10) / 10;

// Au repos : la première colonne pleine, deux post-it dans la deuxième.
const REPOS = [[0, 0], [0, 1], [0, 2], [0, 3], [1, 0], [1, 3]] as const;
// Puis, deux par temps, dans l'ordre où ils apparaissent (pi-1 à pi-4).
const AJOUTS = [[1, 2], [1, 1], [2, 2], [2, 1]] as const;

// Les gestes du PM, cible dans le repère de la scène, lui tourné vers la
// droite ; le bras droit de montre, 32,2, sous l'horizontale.
const centre = (col: number, rang: number) => [BX + COL * (col + 0.5), RANGS[rang] + PI / 2] as const;
const geste = ([x, y]: readonly [number, number], px: number) => montre([x - px, y]).replace('{L}', '');
const PM_REPOS = geste([BX + COL * 1.5, RANGS[3]], PM_1);
const PM_COL2 = geste(centre(1, 2), PM_1);
const PM_COL3 = geste(centre(2, 2), PM_2);
---

<line class="se" x1="0" y1="0" x2="426.667" y2="0" stroke-width="1.5" />
<g transform={`translate(${BX} 0)`} set:html={OBJETS.board} />

{REPOS.map(([c, r]) => (
  <g transform={`translate(${r1(xPostit(c))} ${RANGS[r]})`} set:html={OBJETS.postit} />
))}
{AJOUTS.map(([c, r], i) => (
  <g class={`ms-postit pi-${i + 1}`} transform={`translate(${r1(xPostit(c))} ${RANGS[r]})`} set:html={OBJETS.postit} />
))}
<g class="ms-postit pi-ambre" transform={`translate(${r1(xPostit(3))} -82)`} set:html={OBJETS['postit-retenu']} />

<!-- Jean, à gauche du board, du début à la fin. -->
<g transform={`translate(${J_X} 0)`}>
  <Personnage pose="debout" jean class="j-debout" />
</g>

<!-- Le PM : dans l'écart entre les deux premières colonnes (183), puis, un
     pas plus loin, entre la deuxième et la troisième (222). -->
<g transform={`translate(${PM_1} 0)`}>
  <!-- Après le pas (+39), pm-col3 et pm-debout sont à 222. -->
  <g class="pm-pas">
    <g class="pm-repos" set:html={PM_REPOS} />
    <g class="pm-col2" set:html={PM_COL2} />
    <Personnage pose="marche-2" class="pm-marche" />
    <g class="pm-col3" set:html={PM_COL3} />
    <Personnage pose="debout" class="pm-debout" />
  </g>
</g>

<!-- La designer, au bord droit, tournée vers le board. -->
<g transform={`translate(${D_X} 0)`}>
  <Personnage pose="debout" miroir class="d-debout" />
  <Personnage pose="bras-tendus" miroir class="d-colle" />
</g>

<style is:global>
  .scene--misesEnSituation .pm-pas {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* Repos : la première colonne pleine, le PM colle le bas de la deuxième. */
  .scene--misesEnSituation :is(.ms-postit, .pm-col2, .pm-marche, .pm-col3, .pm-debout, .d-colle) {
    opacity: 0;
  }

  /* 0,6 s, 1 % = 6 ms, trois temps de 33,3 %. Temps 1 (dès 7 %) : le PM
     colle le milieu de la deuxième colonne, deux post-it apparaissent ;
     temps 2 : un pas (33,3-46,7 %), il colle la troisième (46,7 %), deux
     post-it ; temps 3 (66,7 %) : il baisse le bras, la designer colle
     l'ambre à deux mains. Chaque post-it en fondu de 60 ms, le second 30 ms
     après le premier. */
  @media (prefers-reduced-motion: no-preference) {
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pm-repos {
      animation: sc-avant-7 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pm-col2 {
      animation: sc-ms-col2 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pm-marche {
      animation: sc-ms-marche 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pm-col3 {
      animation: sc-ms-col3 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation :is(.pm-debout, .d-colle) {
      animation: sc-ms-apres-67 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .d-debout {
      animation: sc-ms-avant-67 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pm-pas {
      animation: sc-ms-pas 0.6s both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .ms-postit {
      animation: sc-ms-fondu 60ms linear both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pi-1 { animation-delay: 42ms; }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pi-2 { animation-delay: 72ms; }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pi-3 { animation-delay: 280ms; }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pi-4 { animation-delay: 310ms; }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--misesEnSituation .pi-ambre { animation-delay: 400ms; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene--misesEnSituation * { animation: none !important; }
  }

  @keyframes sc-ms-col2 { 0% { opacity: 0; } 7% { opacity: 1; } 33.33%, 100% { opacity: 0; } }
  @keyframes sc-ms-marche { 0% { opacity: 0; } 33.33% { opacity: 1; } 46.67%, 100% { opacity: 0; } }
  @keyframes sc-ms-col3 { 0% { opacity: 0; } 46.67% { opacity: 1; } 66.67%, 100% { opacity: 0; } }
  @keyframes sc-ms-apres-67 { 0% { opacity: 0; } 66.67%, 100% { opacity: 1; } }
  @keyframes sc-ms-avant-67 { 0% { opacity: 1; } 66.67%, 100% { opacity: 0; } }
  /* Le pas vers l'écart suivant (+39), ease-in-out. */
  @keyframes sc-ms-pas {
    0%, 33.33% { transform: translate(0, 0); animation-timing-function: ease-in-out; }
    46.67%, 100% { transform: translate(39px, 0); }
  }
  @keyframes sc-ms-fondu { from { opacity: 0; } to { opacity: 1; } }
</style>
