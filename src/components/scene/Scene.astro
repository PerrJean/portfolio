---
// La scène d'une parcelle de l'accueil : ligne de sol, tréteau, dalle,
// Jean et trois coéquipiers. Deux animations, en échanges de poses figées
// et en déplacements sur la ligne de sol (registre/0022, 0023, 0024) :
//  1. l'impatience (2 s, une chose à la fois : A saute deux fois, B fait
//     tourner son marteau, le porteur lance sa poutre et la rattrape),
//     classe `joue`, au chargement et à chaque entrée à l'écran ;
//  2. « on regarde le plan » (0,9 s, gestes simultanés), au survol ou
//     au focus de la `.parcelle` qui contient la scène, ou classe
//     `regarde` sur écran tactile.
// Géométrie reprise des vignettes de la bibliothèque
// (.canevas/project/B1-personnages.dc.html, script 1).
import Personnage from './Personnage.astro';
import { OBJETS } from './poses';
---

<svg
  class="scene joue"
  viewBox="0 -140 426.667 160"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect class="fd" x="245" y="0" width="175" height="12" />
  <line class="se" x1="0" y1="0" x2="426.667" y2="0" stroke-width="1.5" />

  <!-- La poutre en vol, hors des mains du porteur : lancée puis rattrapée
       (impatience), lancée à terre sur la dalle (survol, centre en 354).
       Origine au milieu du bord bas ; (60, -97) est sa place sur l'épaule. -->
  <g class="poutre" transform="translate(312 0)">
    <g class="poutre-vol" set:html={OBJETS.poutre} />
  </g>

  <!-- Coéquipier A : regarde à droite et saute deux fois ; se retourne en
       se mettant en marche, va derrière le tréteau (235 → 128). -->
  <g transform="translate(235 0)">
    <g class="a-pas">
      <Personnage pose="debout" class="a-debout" />
      <g class="a-bond">
        <Personnage pose="sautillement" class="a-saut" />
      </g>
      <Personnage pose="marche-1" miroir class="a-m1" />
      <Personnage pose="marche-2" miroir class="a-m2" />
      <Personnage pose="penche" class="a-penche" />
    </g>
  </g>

  <g transform="translate(150 0)" set:html={OBJETS.treteau} />

  <!-- Le plan déroulé sur le tréteau, depuis la gauche (x = 100). -->
  <g transform="translate(100 0)">
    <g class="plan">
      <polygon
        class="fi sa"
        points="0,-58 100,-58 106,-66 6,-66"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <line class="sa" x1="5.5" y1="-60" x2="83.7" y2="-60" stroke-width="1" stroke-linecap="round" />
      <line class="sa" x1="7" y1="-62" x2="66.8" y2="-62" stroke-width="1" stroke-linecap="round" />
      <line class="sa" x1="8.5" y1="-64" x2="49.9" y2="-64" stroke-width="1" stroke-linecap="round" />
    </g>
    <g class="rouleau">
      <circle class="fi sa" cx="3" cy="-63" r="5" stroke-width="1.8" />
      <circle class="sa" cx="3" cy="-63" r="2" fill="none" stroke-width="1" />
    </g>
  </g>

  <circle class="point fa" cx="188" cy="-62" r="5" />

  <!-- Jean : plan sous le bras, puis bras tendus, puis penché (55 → 66). -->
  <g transform="translate(55 0)">
    <g class="j-pas">
      <Personnage pose="plan-sous-bras" jean class="j-sous" />
      <Personnage pose="bras-tendus" jean class="j-tendus" />
      <Personnage pose="penche" jean class="j-penche" />
    </g>
  </g>

  <!-- Coéquipier B : tourné vers le porteur, fait tourner son marteau, tenu
       tête en haut ; se retourne et vient en face (285 → 236). L'arc suit
       la tête du marteau (à 31 du poignet (25, -75)), départ en haut, sens
       horaire. -->
  <g transform="translate(285 0)">
    <path
      class="b-arc se"
      d="M25,-106 A31,31 0 1 1 25,-44 A31,31 0 1 1 25,-106"
      pathLength="100"
      fill="none"
      stroke-width="1.5"
      stroke-opacity="0.3"
      stroke-linecap="round"
    />
    <g class="b-pas">
      <Personnage pose="marteau-2" class="b-marteau" />
      <Personnage pose="marche-1" miroir class="b-m1" />
      <Personnage pose="marche-2" miroir class="b-m2" />
      <Personnage pose="penche" miroir class="b-penche" />
    </g>
  </g>

  <!-- Le porteur : poutre sur l'épaule ; la lance (pose « lancer ») et la
       rattrape ; au survol, la lance à terre puis marche derrière B,
       penché vers le plan (368 → 288). -->
  <g transform="translate(368 0)">
    <g class="c-pas">
      <Personnage pose="poutre-epaule" miroir class="c-poutre" />
      <Personnage pose="lancer-poutre" miroir class="c-lance" />
      <Personnage pose="marche-1" miroir class="c-m1" />
      <Personnage pose="marche-2" miroir class="c-m2" />
      <Personnage pose="penche" miroir class="c-penche" />
    </g>
  </g>
</svg>

<style is:global>
  .scene {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene .fe { fill: var(--encre, #2A1F1A); }
  .scene .se { stroke: var(--encre, #2A1F1A); }
  .scene .fi { fill: var(--ivoire, #FEFAF2); }
  .scene .si { stroke: var(--ivoire, #FEFAF2); }
  .scene .sa { stroke: var(--ardoise, #5E7488); }
  .scene .so { stroke: var(--orange, #B54E19); }
  .scene .fa { fill: var(--ambre, #F2A33A); }
  .scene .fd { fill: var(--dalle, #D9D4CC); }

  /* Les groupes animés tournent ou glissent autour de leur origine locale
     (le poignet pour le marteau, le milieu du bord bas pour la poutre en
     vol, le bord gauche pour le plan). */
  .scene .a-pas, .scene .b-pas, .scene .c-pas, .scene .j-pas,
  .scene .plan, .scene .rouleau, .scene .poutre-vol, .scene .marteau-tour,
  .scene .point, .scene .a-bond {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* Repos : une pose visible par personnage. */
  .scene :is(.a-saut, .a-m1, .a-m2, .a-penche, .b-m1, .b-m2, .b-penche,
    .j-tendus, .j-penche, .c-lance, .c-m1, .c-m2, .c-penche, .poutre,
    .rouleau, .point, .b-arc) {
    opacity: 0;
  }
  .scene .plan { transform: scaleX(0); }
  /* Le marteau de B, 1,2 fois plus grand, tenu tête en haut au repos comme
     en fin de tour : marteau-2 le dessine à 25°, -115° le redresse. */
  .scene .b-marteau .marteau-tour { transform: rotate(-115deg) scale(1.2); }
  .scene .b-arc { stroke-dasharray: 30 110; stroke-dashoffset: 30; }

  /* 1. L'impatience, 2 s, une seule chose à la fois : A saute deux fois
     (0-0,56 s), B fait un tour de marteau (0,6-1,3 s), le porteur lance
     sa poutre et la rattrape (1,3-1,8 s). */
  @media (prefers-reduced-motion: no-preference) {
    .scene.joue .a-debout { animation: sc-i-debout 2s step-end both; }
    .scene.joue .a-saut { animation: sc-i-saut 2s step-end both; }
    .scene.joue .a-bond { animation: sc-i-bond 2s both; }
    .scene.joue .b-marteau .marteau-tour {
      animation: sc-i-tour 2s ease-in-out both;
    }
    .scene.joue .b-arc {
      animation: sc-i-arc 2s ease-in-out both, sc-i-arc-vu 2s linear both;
    }
    .scene.joue .c-poutre { animation: sc-i-porte 2s step-end both; }
    .scene.joue :is(.c-lance, .poutre) { animation: sc-i-envol 2s step-end both; }
    .scene.joue .poutre-vol { animation: sc-i-vol 2s both; }
  }

  /* 2. On regarde le plan, 0,9 s, les gestes en même temps. Plus
     spécifique que l'impatience : il l'emporte. */
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene :is(.a-debout, .b-marteau, .c-poutre) {
    animation: sc-avant-8 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .j-sous {
    opacity: 0;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .j-tendus {
    animation: sc-avant-31 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .j-penche {
    animation: sc-apres-31 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .j-pas {
    animation: sc-j-pas 0.9s ease-out both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .plan {
    animation: sc-plan 0.9s ease-out both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .rouleau {
    animation: sc-rouleau 0.9s ease-out both, sc-rouleau-vu 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene :is(.a-saut, .a-bond, .marteau-tour, .b-arc) {
    animation: none;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .a-m1 {
    animation: sc-a-m1 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .a-m2 {
    animation: sc-a-m2 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .a-penche {
    animation: sc-apres-78 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .a-pas {
    animation: sc-a-pas 0.9s linear both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .b-m1 {
    animation: sc-b-m1 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .b-m2 {
    animation: sc-b-m2 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .b-penche {
    animation: sc-apres-47 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .b-pas {
    animation: sc-b-pas 0.9s linear both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .c-lance {
    animation: sc-c-lance 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .poutre {
    animation: sc-apres-8 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .poutre-vol {
    animation: sc-poutre 0.9s both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .c-m1 {
    animation: sc-c-m1 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .c-m2 {
    animation: sc-c-m2 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .c-penche {
    animation: sc-apres-87 0.9s step-end both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .c-pas {
    animation: sc-c-pas 0.9s linear both;
  }
  :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene .point {
    animation: sc-point 0.9s ease-out both;
  }

  /* Sans animation : rien ne bouge, le survol mène droit à l'image finale. */
  @media (prefers-reduced-motion: reduce) {
    .scene, .scene * {
      animation-duration: 0s !important;
      animation-delay: 0s !important;
    }
  }

  /* Impatience, 2 s : 1 % = 20 ms. Deux sauts de 0,22 s (0-11 %, 17-28 %),
     au sol entre les deux ; le tour de 0,6 à 1,3 s (30-65 %) ; la poutre de
     1,3 à 1,8 s (65-90 %). */
  @keyframes sc-i-debout {
    0% { opacity: 0; } 11% { opacity: 1; } 17% { opacity: 0; } 28%, 100% { opacity: 1; }
  }
  @keyframes sc-i-saut {
    0% { opacity: 1; } 11% { opacity: 0; } 17% { opacity: 1; } 28%, 100% { opacity: 0; }
  }
  @keyframes sc-i-bond {
    0% { transform: translateY(0); animation-timing-function: ease-out; }
    5.5% { transform: translateY(-8px); animation-timing-function: ease-in; }
    11%, 17% { transform: translateY(0); animation-timing-function: ease-out; }
    22.5% { transform: translateY(-8px); animation-timing-function: ease-in; }
    28%, 100% { transform: translateY(0); }
  }
  /* Un tour complet, de tête en haut à tête en haut. */
  @keyframes sc-i-tour {
    0%, 30% { transform: rotate(-115deg) scale(1.2); }
    65%, 100% { transform: rotate(245deg) scale(1.2); }
  }
  /* Le trait (30 % du cercle) finit toujours sur la tête du marteau :
     mêmes étapes et même courbe que le tour. */
  @keyframes sc-i-arc {
    0%, 30% { stroke-dashoffset: 30; }
    65%, 100% { stroke-dashoffset: -70; }
  }
  @keyframes sc-i-arc-vu {
    0%, 30% { opacity: 0; } 36%, 60% { opacity: 1; } 72%, 100% { opacity: 0; }
  }
  /* La poutre quitte l'épaule pour les paumes (pose « lancer », 12 plus
     haut), monte à 24 au-dessus de l'épaule, redescend dans les paumes :
     rattrapée, elle revient sur l'épaule (pose « poutre sur l'épaule »). */
  @keyframes sc-i-porte {
    0% { opacity: 1; } 65% { opacity: 0; } 90%, 100% { opacity: 1; }
  }
  @keyframes sc-i-envol {
    0% { opacity: 0; } 65% { opacity: 1; } 90%, 100% { opacity: 0; }
  }
  @keyframes sc-i-vol {
    0%, 65% { transform: translate(60px, -109px) rotate(0deg); animation-timing-function: ease-out; }
    77.5% { transform: translate(60px, -121px) rotate(4deg); animation-timing-function: ease-in; }
    90%, 100% { transform: translate(60px, -109px) rotate(0deg); }
  }

  /* On regarde le plan, 0,9 s : 1 % = 9 ms. Jean tend les bras et
     déroule le plan (0-31 %, 0,4 s), puis se penche. Dès 8 % (0,1 s), A
     marche (8-78 %, 5 pas de 0,18 s) et B marche (8-47 %, 3 pas de
     0,17 s), chacun se penche en arrivant ; le porteur lance sa poutre à
     terre (8-31 %) puis marche (31-87 %, 4 pas de 0,18 s) et se penche à
     1,13 s ; le point se pose en dernier (90-100 %). A part plus vite que
     B ne le suit : l'écart entre eux ne descend jamais sous 50. */
  @keyframes sc-avant-8 { 0% { opacity: 1; } 8%, 100% { opacity: 0; } }
  @keyframes sc-apres-8 { 0% { opacity: 0; } 8%, 100% { opacity: 1; } }
  @keyframes sc-avant-31 { 0% { opacity: 1; } 31%, 100% { opacity: 0; } }
  @keyframes sc-apres-31 { 0% { opacity: 0; } 31%, 100% { opacity: 1; } }
  @keyframes sc-apres-47 { 0% { opacity: 0; } 47%, 100% { opacity: 1; } }
  @keyframes sc-apres-78 { 0% { opacity: 0; } 78%, 100% { opacity: 1; } }
  @keyframes sc-apres-87 { 0% { opacity: 0; } 87%, 100% { opacity: 1; } }
  @keyframes sc-c-lance { 0% { opacity: 0; } 8% { opacity: 1; } 31%, 100% { opacity: 0; } }
  @keyframes sc-j-pas {
    0% { transform: translateX(0); }
    12%, 30.9% { transform: translateX(13px); }
    31%, 100% { transform: translateX(11px); }
  }
  @keyframes sc-plan {
    0%, 4% { transform: scaleX(0); }
    31%, 100% { transform: scaleX(1); }
  }
  @keyframes sc-rouleau {
    0%, 4% { transform: translateX(0); }
    31%, 100% { transform: translateX(100px); }
  }
  @keyframes sc-rouleau-vu { 0% { opacity: 0; } 4% { opacity: 1; } 31%, 100% { opacity: 0; } }
  /* Marche : les deux temps alternent, 14 % (0,18 s) pour A et le porteur,
     13 % (0,17 s) pour B. */
  @keyframes sc-a-m1 {
    0% { opacity: 0; } 8% { opacity: 1; } 22% { opacity: 0; } 36% { opacity: 1; }
    50% { opacity: 0; } 64% { opacity: 1; } 78%, 100% { opacity: 0; }
  }
  @keyframes sc-a-m2 {
    0% { opacity: 0; } 22% { opacity: 1; } 36% { opacity: 0; } 50% { opacity: 1; }
    64%, 100% { opacity: 0; }
  }
  @keyframes sc-b-m1 {
    0% { opacity: 0; } 8% { opacity: 1; } 21% { opacity: 0; } 34% { opacity: 1; }
    47%, 100% { opacity: 0; }
  }
  @keyframes sc-b-m2 {
    0% { opacity: 0; } 21% { opacity: 1; } 34%, 100% { opacity: 0; }
  }
  @keyframes sc-c-m1 {
    0% { opacity: 0; } 31% { opacity: 1; } 45% { opacity: 0; } 59% { opacity: 1; }
    73%, 100% { opacity: 0; }
  }
  @keyframes sc-c-m2 {
    0% { opacity: 0; } 45% { opacity: 1; } 59% { opacity: 0; } 73% { opacity: 1; }
    87%, 100% { opacity: 0; }
  }
  @keyframes sc-a-pas {
    0%, 8% { transform: translateX(0); }
    78%, 100% { transform: translateX(-107px); }
  }
  @keyframes sc-b-pas {
    0%, 8% { transform: translateX(0); }
    47%, 100% { transform: translateX(-49px); }
  }
  /* Le porteur s'arrête en 288, derrière B, sans le toucher. */
  @keyframes sc-c-pas {
    0%, 31% { transform: translateX(0); }
    87%, 100% { transform: translateX(-80px); }
  }
  /* La poutre part des paumes, monte un peu (0,1 s), retombe à plat sur la
     dalle, près du porteur (de 304 à 404). */
  @keyframes sc-poutre {
    0%, 8% { transform: translate(60px, -109px) rotate(0deg); animation-timing-function: ease-out; }
    16% { transform: translate(56px, -118px) rotate(-5deg); animation-timing-function: ease-in; }
    31%, 100% { transform: translate(42px, 0) rotate(0deg); }
  }
  @keyframes sc-point {
    0%, 90% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Le strict nécessaire : rejouer l'impatience à chaque entrée à l'écran,
  // et, sur écran tactile, jouer une fois « on regarde le plan » après elle.
  const DUREE = 2100;
  const tactile = matchMedia('(hover: none)').matches;

  document.querySelectorAll<SVGSVGElement>('svg.scene').forEach((scene) => {
    const parcelle = scene.closest('.parcelle');
    let fin = performance.now() + DUREE;
    let minuteur = setTimeout(() => scene.classList.remove('joue'), DUREE);
    let dedans = true;
    let vu = false;

    const jouer = () => {
      scene.classList.remove('joue');
      void scene.getBoundingClientRect();
      scene.classList.add('joue');
      clearTimeout(minuteur);
      minuteur = setTimeout(() => scene.classList.remove('joue'), DUREE);
      fin = performance.now() + DUREE;
    };

    new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) {
          if (!e.isIntersecting) {
            dedans = false;
            continue;
          }
          if (!dedans) {
            dedans = true;
            if (!parcelle?.classList.contains('regarde')) jouer();
          }
          const entiere =
            e.intersectionRatio >= 0.99 ||
            e.intersectionRect.height >= (e.rootBounds?.height ?? Infinity) - 1;
          if (tactile && parcelle && !vu && entiere) {
            vu = true;
            const attente = Math.max(0, fin - performance.now());
            setTimeout(() => parcelle.classList.add('regarde'), attente);
          }
        }
      },
      { threshold: [0, 1] }
    ).observe(parcelle ?? scene);
  });
</script>
