---
// Les scènes de l'accueil, une par variante (registre/0022 à 0024, 0057,
// 0058), en échanges de poses figées et en déplacements sur la ligne de sol :
//  - entete : l'équipe (trois ouvriers anonymes) sous le soleil,
//    l'impatience jouée une fois au chargement (SceneEntete.astro) ;
//  - uservoice : Jean seul déroule le plan sur le tréteau (SceneUservoice) ;
//  - audit : Jean sur le plan, l'équipe le rejoint (SceneAudit).
// Les cartes jouent au survol ou au focus de la `.parcelle` qui contient la
// scène, et reviennent au repos quand ils cessent ; sans survol (écran
// tactile), une fois quand la scène arrive au milieu de l'écran (classe
// `regarde`, script ci-dessous), puis figées sur la fin. Mouvement réduit :
// l'image de repos, rien ne bouge.
// Images clés : ops/images/accueil/planche.png (planche.mjs), même repère.
import SceneEntete from './SceneEntete.astro';
import SceneUservoice from './SceneUservoice.astro';
import SceneAudit from './SceneAudit.astro';

interface Props {
  variante: 'entete' | 'uservoice' | 'audit';
  class?: string;
}
const { variante, class: classe } = Astro.props;
// L'en-tête ne garde que la partie droite du repère (A, B, le porteur et
// les écarts de l'impatience) : entete.svg.
const VUE = variante === 'entete' ? '205 -140 221.667 160' : '0 -140 426.667 160';
---

<svg
  class:list={['scene', `scene--${variante}`, classe]}
  viewBox={VUE}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {variante === 'entete' && <SceneEntete />}
  {variante === 'uservoice' && <SceneUservoice />}
  {variante === 'audit' && <SceneAudit />}
</svg>

<style is:global>
  .scene {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene .fe { fill: var(--encre, #2A1F1A); }
  .scene .se { stroke: var(--encre, #2A1F1A); }
  .scene .fi { fill: var(--ivoire, #FEFAF2); }
  .scene .si { stroke: var(--ivoire, #FEFAF2); }
  .scene .sa { stroke: var(--ardoise, #5E7488); }
  .scene .so { stroke: var(--orange, #B54E19); }
  .scene .fa { fill: var(--ambre, #F2A33A); }
  .scene .fd { fill: var(--dalle, #D9D4CC); }

  /* Les groupes animés tournent ou glissent autour de leur origine locale
     (le poignet pour le marteau en main, le milieu du bord bas pour la
     poutre en vol, le bord gauche pour le plan, l'origine du repère pour le
     marteau lâché). */
  .scene :is(.a-pas, .b-pas, .c-pas, .j-pas, .plan, .rouleau, .poutre-vol,
    .marteau-tour, .marteau-vol, .point, .a-bond) {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* Le marteau de B, 1,2 fois plus grand, tenu tête en haut au repos :
     marteau-2 le dessine à 25°, -115° le redresse. */
  .scene .b-marteau .marteau-tour { transform: rotate(-115deg) scale(1.2); }

  /* Les bascules communes : une pose s'efface ou apparaît à N % du geste. */
  @keyframes sc-avant-7 { 0% { opacity: 1; } 7%, 100% { opacity: 0; } }
  @keyframes sc-apres-7 { 0% { opacity: 0; } 7%, 100% { opacity: 1; } }
  @keyframes sc-avant-26 { 0% { opacity: 1; } 26.5%, 100% { opacity: 0; } }
  @keyframes sc-apres-26 { 0% { opacity: 0; } 26.5%, 100% { opacity: 1; } }
  @keyframes sc-avant-40 { 0% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes sc-apres-40 { 0% { opacity: 0; } 40%, 100% { opacity: 1; } }
  @keyframes sc-apres-65 { 0% { opacity: 0; } 65.5%, 100% { opacity: 1; } }
  @keyframes sc-apres-85 { 0% { opacity: 0; } 85%, 100% { opacity: 1; } }
  /* Le point ambre se pose en dernier. */
  @keyframes sc-point {
    0%, 87% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene, .scene * { animation: none !important; }
  }
</style>

<script>
  // Sans survol (écran tactile) : chaque carte joue une fois quand sa scène
  // arrive au milieu de l'écran (son haut passe la ligne médiane), ou d'emblée
  // si elle est déjà au-dessus ; la classe `regarde` reste, la fin est figée.
  // En bas de page, une scène peut ne jamais atteindre le milieu : elle joue
  // dès qu'elle est entière à l'écran si le défilement restant ne suffira
  // pas à l'y mener. L'en-tête n'a besoin de rien : il joue au chargement.
  if (
    matchMedia('(hover: none)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const jouer = (scene: Element) => {
      scene.closest('.parcelle')?.classList.add('regarde');
      milieu.unobserve(scene);
      entiere.unobserve(scene);
    };
    const milieu = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) {
          if (e.isIntersecting || e.boundingClientRect.bottom <= 0) jouer(e.target);
        }
      },
      { rootMargin: '0px 0px -50% 0px' }
    );
    const entiere = new IntersectionObserver(
      (entrees) => {
        const reste = document.documentElement.scrollHeight - scrollY - innerHeight;
        for (const e of entrees) {
          const aParcourir = e.boundingClientRect.top - innerHeight / 2;
          if (e.intersectionRatio >= 0.95 && aParcourir > reste) jouer(e.target);
        }
      },
      { threshold: [0.95, 1] }
    );
    document.querySelectorAll('.parcelle svg.scene').forEach((scene) => {
      milieu.observe(scene);
      entiere.observe(scene);
    });
  }
</script>
