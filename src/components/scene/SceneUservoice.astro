---
// La carte 01 UserVoice (registre/0058) : Jean seul, le plan roulé sous le
// bras (ops/images/accueil/01-repos.svg) ; au survol ou au focus de la
// carte, en 0,6 s, il tend les bras, déroule le plan sur le tréteau et se
// penche dessus, le point ambre se pose (01-fin.svg).
// À rendre dans Scene.astro (variante « uservoice »), qui porte les
// couleurs, les bascules communes et le déclenchement sans survol.
import Personnage from './Personnage.astro';
import { OBJETS } from './poses';
---

<rect class="fd" x="245" y="0" width="175" height="12" />
<line class="se" x1="0" y1="0" x2="426.667" y2="0" stroke-width="1.5" />
<g transform="translate(150 0)" set:html={OBJETS.treteau} />

<!-- Le plan déroulé sur le tréteau, depuis la gauche (x = 100). -->
<g transform="translate(100 0)">
  <g class="plan">
    <polygon class="fi sa" points="0,-58 100,-58 106,-66 6,-66" stroke-width="1.5" stroke-linejoin="round" />
    <line class="sa" x1="5.5" y1="-60" x2="83.7" y2="-60" stroke-width="1" stroke-linecap="round" />
    <line class="sa" x1="7" y1="-62" x2="66.8" y2="-62" stroke-width="1" stroke-linecap="round" />
    <line class="sa" x1="8.5" y1="-64" x2="49.9" y2="-64" stroke-width="1" stroke-linecap="round" />
  </g>
  <g class="rouleau">
    <circle class="fi sa" cx="3" cy="-63" r="5" stroke-width="1.8" />
    <circle class="sa" cx="3" cy="-63" r="2" fill="none" stroke-width="1" />
  </g>
</g>

<circle class="point fa" cx="188" cy="-62" r="5" />

<!-- Jean : plan sous le bras, puis bras tendus, puis penché (55 → 66). -->
<g transform="translate(55 0)">
  <g class="j-pas">
    <Personnage pose="plan-sous-bras" jean class="j-sous" />
    <Personnage pose="bras-tendus" jean class="j-tendus" />
    <Personnage pose="penche" jean class="j-penche" />
  </g>
</g>

<style is:global>
  /* Repos : Jean seul, le plan roulé sous le bras. */
  .scene--uservoice :is(.j-tendus, .j-penche, .rouleau, .point) { opacity: 0; }
  .scene--uservoice .plan { transform: scaleX(0); }

  /* 0,6 s, 1 % = 6 ms. Jean tend les bras et déroule le plan (5-40 %,
     0,21 s), fait un pas vers le tréteau, puis se penche (40 %) ; le point
     se pose en dernier (87-100 %). Hors survol, retour au repos. */
  @media (prefers-reduced-motion: no-preference) {
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .j-sous {
      opacity: 0;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .j-tendus {
      animation: sc-avant-40 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .j-penche {
      animation: sc-apres-40 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .j-pas {
      animation: sc-uv-pas 0.6s ease-out both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .plan {
      animation: sc-uv-plan 0.6s ease-out both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .rouleau {
      animation: sc-uv-rouleau 0.6s ease-out both, sc-uv-rouleau-vu 0.6s step-end both;
    }
    :is(.parcelle:hover, .parcelle:focus-within, .parcelle.regarde) .scene--uservoice .point {
      animation: sc-point 0.6s ease-out both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene--uservoice * { animation: none !important; }
  }

  @keyframes sc-uv-pas {
    0% { transform: translateX(0); }
    15%, 39.9% { transform: translateX(13px); }
    40%, 100% { transform: translateX(11px); }
  }
  @keyframes sc-uv-plan {
    0%, 5% { transform: scaleX(0); }
    40%, 100% { transform: scaleX(1); }
  }
  @keyframes sc-uv-rouleau {
    0%, 5% { transform: translateX(0); }
    40%, 100% { transform: translateX(100px); }
  }
  @keyframes sc-uv-rouleau-vu { 0% { opacity: 0; } 5% { opacity: 1; } 40%, 100% { opacity: 0; } }
</style>
